node_modules/
dist/
.env
.env.*
!.env.example
!.env.test
!.env.test.example
# A hand-kept environment file: this one holds the Full-mode (external
# PostgreSQL) configuration. `.env.*` does not match it — that pattern needs a
# literal dot after `env` — so it is named here. It carries
# CARTETHYIA_ENCRYPTION_KEY and the database URL, so it must never be staged.
.envx
*.log
.codegraph/
*.tsbuildinfo

# Local runtime scratch (e.g. generated proxy process configs).
.cache/

# Throwaway probe/debug scripts written during an investigation. Never
# committed: they are one-off reproduction helpers, not project code.
.tmp-*

# Saved terminal transcripts (e.g. a session log written to the repo root by
# mistake). Never project code.
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Local runtime scratch: captured telemetry payload frames. Written constantly
# by the running gateway and pruned by retention, so tracking them churns the
# repo with megabytes of transient request bodies.
# `data/*`, NOT `data/`: excluding the directory itself makes git stop
# descending into it, and a negation for something inside a directory git never
# enters is silently ignored — the checked-in catalogs below were skipped by
# `git add -A` for exactly that reason. Matching the children keeps the
# directory traversable so the re-include can take effect.
data/*
# Checked-in provider model catalogs. Hand-reviewed live captures the catalog
# sync is verified against — not runtime scratch, so they are tracked.
!data/provider-catalogs/
# Keep the dashboard's checked-in browser data layer distinct from runtime payloads.
!dashboard/src/data/
!dashboard/src/data/**

# Agent working state: per-session worktrees under `.claude/worktrees/` are full
# repository checkouts created by tooling, plus local settings that differ per
# machine. Never project code, and `git add -A` would otherwise stage entire
# duplicate trees.
.claude/

# Backup export dumps written to the repo root during an investigation. A
# backup carries every provider credential and API-key hash in the clear, so a
# file left here is a secret leak waiting for `git add -A`. Keep them out of the
# repo entirely; a real backup belongs wherever the operator stores it.
backup-probe.json
cartethyia-backup-*.json
.cleanup-work/

# Local browser-automation tooling (Cartemo). Not project code; keep out of
# the repo.
Cartemo/

# Visual regression baseline captured by scripts/dev/visual-baseline.ts.
# A measurement artifact, not a source of truth — regenerate, do not review.
dashboard/visual/

# Live OAuth sessions captured by provider probes. A saved `accounts.json`
# carries access + refresh tokens in the clear; it belongs in scratch, never in
# a commit.
scripts/provider-probing/**/accounts*.json
