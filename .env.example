# Cartethyia gateway settings. Copy to `.env` and edit.
# The full variable list lives in `documentation/reference/configuration.md`.

# Database mode — the one choice that matters.
#   lite = embedded database, nothing to install (default — just run it).
#   full = external PostgreSQL via DATABASE_URL (VPS, share/selling, teams).
# Moving lite → full later is a JSON backup export + import, no rebuild.
CARTETHYIA_DB_MODE=lite

# HTTP port the gateway/console listen on.
PORT=12800

# Address the gateway binds. Set 127.0.0.1 behind a same-host reverse proxy
# or cloudflared.
#
# Two deployment notes:
# - Docker Compose ignores this value — it pins 0.0.0.0 because docker-proxy
#   reaches the container over its own IP. Widen the *host* port publish with
#   CARTETHYIA_PUBLISH_HOST (default: loopback, 127.0.0.1).
# - Point reverse proxies and tunnel origins at http://127.0.0.1:<PORT>,
#   never http://localhost:<PORT>. `localhost` can resolve to ::1 first and
#   dead-dial an IPv4-only bind (live 2026-11-16 origin misconfig).
CARTETHYIA_BIND_HOST=0.0.0.0

# development | production (affects logging/validation strictness).
NODE_ENV=development

# Built dashboard static directory served at /console.
DASHBOARD_DIST=./dist/dashboard

# pino level: debug / info / warn / error.
LOG_LEVEL=debug

# Required in full mode only; ignored in lite. Point it at a PgBouncer
# (transaction mode), not the PostgreSQL server itself — see DATABASE_POOL_MAX.
# DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:6432/cartethyia

# Required 256-bit secret that encrypts provider credentials and API keys.
# Generate (32 bytes = 256 bits):  openssl rand -hex 32
#   or  bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# Either 64-char hex or base64 decoding to 32 bytes is accepted. The
# setup/install helpers generate one automatically when the .env is created.
CARTETHYIA_ENCRYPTION_KEY=replace-with-cartethyia-encryption-key

# Externally reachable URL for OAuth callbacks/links.
CARTETHYIA_PUBLIC_ORIGIN=http://localhost:12800

# ---------------------------------------------------------------------------
# Optional settings.
#
# Redis is never required: set REDIS_URL for shared coordination across
# instances, or leave it unset for the in-memory backend.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379 # Shared Redis; omit for in-memory.

# Writable state root. Lite stores <dir>/cartethyia.sqlite; OS default otherwise.
# CARTETHYIA_DATA_DIR=

# Trust forwarded client-IP headers from these proxy ranges. Unset trusts only
# the loopback peer (127.0.0.1, ::1), so cloudflared and local Caddy/Nginx keep
# per-caller addresses; every other peer's headers are ignored.
# Behind cloudflared or a local reverse proxy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# TRUSTED_PROXY_CIDRS=

# Private CIDRs allowed for upstream connections.
# CARTETHYIA_ALLOWED_NETWORKS=

# Payload capture directory.
# CARTETHYIA_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads

# npm CLI only: directory holding .env. OS default otherwise.
# CARTETHYIA_CONFIG_DIR=

# Input accounting: inclusive (fold cache into IN) or as-is (raw upstream semantics).
# CARTETHYIA_USAGE_INPUT_MODE=inclusive

# GitHub Copilot OAuth profile:
#   opencode-copilot   (default) OpenCode OAuth app + raw GitHub token.
#   vscode-client-real           VS Code OAuth app + minted Copilot token.
# Restart and re-authenticate accounts after switching.
# CARTETHYIA_GITHUB_COPILOT_MODE=opencode-copilot

# Dashboard dev port override (default 5173, fallback 1931 if occupied).
# DASHBOARD_PORT=

# Gateway URL for the dashboard dev proxy (defaults to http://127.0.0.1:<PORT>).
# VITE_BACKEND_URL=

# ---------------------------------------------------------------------------
# Defaults and overrides.
#
# Uncomment only when the built-in default is not suitable. The full list
# lives in `documentation/reference/configuration.md`; everything below is
# the subset an operator realistically touches.
# ---------------------------------------------------------------------------

# Request limits, memory warning, and graceful shutdown.

# Maximum request body size (16 MB admits a 1M-token context).
# CARTETHYIA_SERVER_MAX_BODY_BYTES=16777216

# Tool-result payload ceiling in KiB (0 = off; rewrites client-visible content).
# CARTETHYIA_TOOL_RESULT_MAX_KB=0

# Idle connection timeout in seconds.
# CARTETHYIA_SERVER_IDLE_TIMEOUT=60

# Time for active requests to finish.
# CARTETHYIA_SHUTDOWN_DRAIN_WINDOW_MS=20000

# Enables POST /admin/drain; loopback peer plus this token. Unset disables the route.
# CARTETHYIA_DRAIN_TOKEN=

# Explicit memory warning limit.
# CARTETHYIA_MEMORY_LIMIT_BYTES=536870912

# Slack above each key's concurrency limit. Effective ceiling is limit + tolerance.
# CARTETHYIA_CONCURRENCY_TOLERANCE=3

# Gateway processes sharing the port. >1 requires Linux, full mode, and reachable Redis.
# CARTETHYIA_PROCESS_COUNT=1

# Which process this is (0 - count-1). Required when count > 1.
# CARTETHYIA_PROCESS_INDEX=0

# Network and abuse policy.

# Allow private upstream addresses.
# CARTETHYIA_ALLOW_PRIVATE_UPSTREAMS=true

# Maximum upstream redirects.
# CARTETHYIA_MAX_REDIRECTS=3

# Requests per client IP in the rate window.
# IP_RATE_MAX_PER_WINDOW=540

# Max parallel test workers (default: min(cpu, 4)).
# CARTETHYIA_TEST_JOBS=4

# Upstream deadlines and fallback retry timing.

# Overall upstream request deadline (tunable per-tenant from the Settings
# panel). Kept below the ~90s client budget so a stalled upstream fails inside
# the client's window rather than past it.
# CARTETHYIA_UPSTREAM_TIMEOUT_MS=75000

# Maximum stream silence.
# CARTETHYIA_STREAM_STALL_TIMEOUT_MS=360000

# Time to first visible chunk.
# CARTETHYIA_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000

# Minimum / maximum fallback retry delay.
# CARTETHYIA_FALLBACK_RETRY_BASE_MS=100
# CARTETHYIA_FALLBACK_RETRY_CAP_MS=2000

# Per-request candidate dispatch attempt cap.
# CARTETHYIA_ROUTE_MAX_ATTEMPTS=8

# Account health cooldowns and routing preferences.

# Rate-limit cooldown.
# CARTETHYIA_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000

# Quota cooldown.
# CARTETHYIA_ACCOUNT_QUOTA_COOLDOWN_MS=3600000

# Model-capacity cooldown.
# CARTETHYIA_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000

# Temporary error cooldown.
# CARTETHYIA_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000

# Unclassified error cooldown. 15 min keeps an unknown failure from being
# retried into a thrash loop; raise only after classifying the error.
# CARTETHYIA_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=900000

# Ceiling an escalated fallback may reach.
# CARTETHYIA_ACCOUNT_COOLDOWN_ESCALATION_MAX_MS=3600000

# Bare 401/403 backoff, before a named revocation.
# CARTETHYIA_ACCOUNT_AUTH_REJECTED_COOLDOWN_MS=300000

# Auto-disable recovery window; 0 restores terminal.
# CARTETHYIA_ACCOUNT_DISABLED_RECOVERY_MS=86400000

# Routing reserve: accounts at/below this remaining-quota % are demoted (never excluded).
# CARTETHYIA_ACCOUNT_RESERVE_PCT=20

# Session-sticky warm window; prefer the last account that served a session within it.
# CARTETHYIA_ROUTING_STICKY_WARM_MS=300000

# LRU cap on remembered session→account sticky state per provider.
# CARTETHYIA_ROUTING_STICKY_MAX_SESSIONS=256

# Database and proxy pool sizing.

# Max Postgres connections per process (default 16). Behind a PgBouncer keep
# it at or below the bouncer's default_pool_size (the Docker compose `full`
# profile ships one tuned to 12 for a 1-2 GB VPS) so the app never queues on
# its own pool; a 1-vCPU server cannot use more than ~12 anyway.
# DATABASE_POOL_MAX=12

# Idle connections kept warm; excess are closed by the shrinker.
# DATABASE_POOL_IDLE_FLOOR=2

# Proxy-pool failure cooldown.
# CARTETHYIA_POOL_COOLDOWN_MS=120000

# Fallback egress cooldown when an upstream 429 names no window.
# CARTETHYIA_POOL_PROVIDER_RATE_LIMIT_COOLDOWN_MS=3600000

# Maximum active / idle proxy sockets.
# CARTETHYIA_PROXY_MAX_SOCKETS=100
# CARTETHYIA_PROXY_MAX_FREE_SOCKETS=20

# Provider-specific tuning (Qoder cadence, Cursor client identity/heartbeat/
# wire trace, ZCode auto-claim, and more) lives in
# `documentation/reference/configuration.md`.
