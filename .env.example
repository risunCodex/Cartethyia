# Required runtime settings.
# ---------------------------------------------------------------------------
# Database mode (the one choice that matters):
#   lite = embedded database, nothing to install (default — just run it).
#   full = external PostgreSQL via DATABASE_URL (VPS, share/selling, teams).
# Moving lite → full later is a JSON backup export + import, no rebuild.
# PORT                  — HTTP port the gateway/console listen on.
# NODE_ENV              — development | production (affects logging/validation strictness).
# DASHBOARD_DIST        — built dashboard static directory served at /console.
# LOG_LEVEL             — pino level: debug / info / warn / error.
# CARTETHYIA_DB_MODE    — REQUIRED, no default: lite or full. The gateway throws
#                         at boot when it is absent rather than guessing, because
#                         the two modes are different databases with separate
#                         migration sets and a silent guess would pick which one
#                         an install's data is read against. `bun setup` writes it.
# DATABASE_URL          — required in full mode only; ignored in lite.
# CARTETHYIA_ENCRYPTION_KEY
#                       — required 256-bit secret that encrypts provider credentials
#                         and API keys. Generate with one of the commands below.
# CARTETHYIA_PUBLIC_ORIGIN
#                       — externally reachable URL for OAuth callbacks/links.
# CARTETHYIA_API_KEY    — optional default gateway API key. Unset means none,
#                         which is the recommended starting point: the console
#                         generates and shows the default key at first boot, and
#                         seeding one from the environment means the secret sits
#                         in a file that gets copied around.
# INFERHUB_CONFIG_KEY   — optional InferHub `config_read` key, used only when no
#                         InferHub provider account carries one in `auth_state`.
#                         Reads the marketplace catalog (prices, availability).
#                         Must be a config_read key — never an inference key.

# lite keeps this file the zero-dependency first run: embedded SQLite in the data
# dir, no server to install. Switch to full for a VPS or shared workload — see the
# Full section of documentation/getting-started.md.
CARTETHYIA_DB_MODE=lite
PORT=12800
NODE_ENV=development
DASHBOARD_DIST=./dist/dashboard
LOG_LEVEL=debug
# DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/cartethyia
CARTETHYIA_ENCRYPTION_KEY=replace-with-cartethyia-encryption-key
CARTETHYIA_PUBLIC_ORIGIN=http://localhost:12800

# How to generate CARTETHYIA_ENCRYPTION_KEY (choose ONE; 32 bytes = 256 bits):
#   macOS / Linux:  openssl rand -hex 32
#   Windows (PowerShell):  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Bun / Node (any platform):  bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# Paste the output as the key value. Either 64-char hex or base64 that decodes to 32 bytes is accepted.
# The setup/install helpers generate one automatically when the .env is created.

# Optional settings. Redis is never required: set REDIS_URL for shared
# coordination across instances, or leave it unset for the in-memory backend.
# REDIS_URL=redis://localhost:6379 # Shared Redis; omit for in-memory.
# CARTETHYIA_DATA_DIR= # Writable state root. Lite stores <dir>/cartethyia.sqlite; OS default otherwise.
# TRUSTED_PROXY_CIDRS= # Trust forwarded client-IP headers from these proxy ranges.
#   Set this when a reverse proxy or tunnel fronts the gateway. Unset, the loopback
#   peer (127.0.0.1, ::1) is trusted on its own so cloudflared and local Caddy/Nginx
#   keep per-caller addresses; every other peer's headers are ignored. With the
#   variable set, only the ranges named here are trusted.
#   Behind cloudflared or a local reverse proxy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# CARTETHYIA_ALLOWED_NETWORKS= # Private CIDRs allowed for upstream connections.
# CARTETHYIA_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads # Payload capture directory.
# CARTETHYIA_CONFIG_DIR= # npm CLI only: directory holding .env. OS default otherwise.
# CARTETHYIA_USAGE_INPUT_MODE=inclusive # input accounting: inclusive (fold cache into IN) or as-is (raw upstream semantics).
# DASHBOARD_PORT= # Dashboard dev port override (default 5173, fallback 1931 if occupied).
# VITE_BACKEND_URL= # Gateway URL for dashboard dev proxy (defaults to http://127.0.0.1:<PORT>).
# CARTETHYIA_ZCODE_AUTO_CLAIM=false # Set true to claim ZCode gifts daily for active accounts. Manual claim stays available.
# CARTETHYIA_GITHUB_COPILOT_MODE=opencode-copilot # GitHub Copilot wire identity:
# opencode-copilot (default, raw GitHub token + minimal headers) or
# vscode-client-real (minted Copilot token + full VS Code reference headers).

# Defaults and overrides. Uncomment only when the built-in default is not
# suitable. The full list lives in `documentation/reference/configuration.md`;
# everything below is the subset an operator realistically touches.

# Request limits, memory warning, and graceful shutdown.
# CARTETHYIA_SERVER_MAX_BODY_BYTES=16777216 # Maximum request body size (16 MB admits a 1M-token context).
# CARTETHYIA_SERVER_IDLE_TIMEOUT=60 # Idle connection timeout in seconds.
# CARTETHYIA_SHUTDOWN_DRAIN_WINDOW_MS=20000 # Time for active requests to finish.
# CARTETHYIA_DRAIN_TOKEN= # Enables POST /admin/drain; loopback peer plus this token. Unset disables the route.
# CARTETHYIA_MEMORY_LIMIT_BYTES=536870912 # Explicit memory warning limit.
# CARTETHYIA_CONCURRENCY_TOLERANCE=3 # Slack above each key's concurrency limit. Effective ceiling is limit + tolerance.
# CARTETHYIA_PROCESS_COUNT=1 # Gateway processes sharing the port. >1 requires Linux, full mode, and reachable Redis.
# CARTETHYIA_PROCESS_INDEX=0 # Which process this is (0 - count-1). Required when count > 1.

# Network and abuse policy.
# CARTETHYIA_ALLOW_PRIVATE_UPSTREAMS=true # Allow private upstream addresses.
# CARTETHYIA_MAX_REDIRECTS=3 # Maximum upstream redirects.
# IP_RATE_MAX_PER_WINDOW=540 # Requests per client IP in the rate window.
# CARTETHYIA_QODER_UMID_MINI=0 # Force mini-ELF UMID bundle on Linux (1) or disable container auto-detect (0).
# CARTETHYIA_TEST_JOBS=4 # Max parallel test workers (default: min(cpu, 4)).
# Upstream deadlines and fallback retry timing.
# CARTETHYIA_UPSTREAM_TIMEOUT_MS is tunable per-tenant from the Settings panel.
# CARTETHYIA_UPSTREAM_TIMEOUT_MS=75000 # Overall upstream request deadline. Kept below the ~90s client budget so a stalled upstream fails inside the client's window rather than past it.
# CARTETHYIA_STREAM_STALL_TIMEOUT_MS=360000 # Maximum stream silence.
# CARTETHYIA_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000 # Time to first visible chunk.
# CARTETHYIA_FALLBACK_RETRY_BASE_MS=100 # Minimum fallback retry delay.
# CARTETHYIA_FALLBACK_RETRY_CAP_MS=2000 # Maximum fallback retry delay.
# CARTETHYIA_ROUTE_MAX_ATTEMPTS=8 # Per-request candidate dispatch attempt cap.

# Account and proxy-pool cooldowns and socket limits.
# CARTETHYIA_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000 # Rate-limit cooldown.
# CARTETHYIA_ACCOUNT_QUOTA_COOLDOWN_MS=3600000 # Quota cooldown.
# CARTETHYIA_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000 # Model-capacity cooldown.
# CARTETHYIA_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000 # Temporary error cooldown.
# CARTETHYIA_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=900000 # Unclassified error cooldown. 15 min keeps an unknown failure from being retried into a thrash loop; raise only after classifying the error.
# CARTETHYIA_ACCOUNT_COOLDOWN_ESCALATION_MAX_MS=3600000 # Ceiling an escalated fallback may reach.
# CARTETHYIA_ACCOUNT_AUTH_REJECTED_COOLDOWN_MS=300000 # Bare 401/403 backoff, before a named revocation.
# CARTETHYIA_ACCOUNT_POLICY_BLOCK_COOLDOWN_MS=300000 # Buddy policy/channel block base backoff.
# CARTETHYIA_ACCOUNT_DISABLED_RECOVERY_MS=86400000 # Auto-disable recovery window; 0 restores terminal.
# DATABASE_POOL_MAX=8 # Max Postgres connections per process (default 8).
# DATABASE_POOL_IDLE_FLOOR=2 # Idle connections kept warm; excess are closed by the shrinker.
# CARTETHYIA_POOL_COOLDOWN_MS=120000 # Proxy-pool failure cooldown.
# CARTETHYIA_POOL_PROVIDER_RATE_LIMIT_COOLDOWN_MS=3600000 # Fallback egress cooldown when an upstream 429 names no window.
# CARTETHYIA_PROXY_MAX_SOCKETS=100 # Maximum active proxy sockets.
# CARTETHYIA_PROXY_MAX_FREE_SOCKETS=20 # Maximum idle proxy sockets.
